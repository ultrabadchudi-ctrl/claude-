{
  "name": "WA Agent 3 - Doc Reader",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Doc reader webhook"
        }
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "WA_TOKEN",
            "value": "PASTE_WHATSAPP_PERMANENT_ACCESS_TOKEN"
          },
          {
            "name": "GRAPH_VERSION",
            "value": "v23.0"
          },
          {
            "name": "ANTHROPIC_API_KEY",
            "value": "PASTE_ANTHROPIC_API_KEY"
          },
          {
            "name": "MODEL",
            "value": "claude-opus-5-5"
          }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "CONFIG (yahan apni values bharein)"
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "File / Google Doc / nothing"
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://graph.facebook.com/{{2.GRAPH_VERSION}}/{{1.media_id}}",
                "method": "get",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{2.WA_TOKEN}}"
                  }
                ],
                "qs": [],
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "300",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "serializeUrl": false,
                "followAllRedirects": false
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -200,
                  "name": "Media info"
                }
              },
              "filter": {
                "name": "Has file",
                "conditions": [
                  [
                    {
                      "a": "{{length(1.media_id)}}",
                      "o": "number:greater",
                      "b": "0"
                    }
                  ]
                ]
              }
            },
            {
              "id": 5,
              "module": "http:ActionGetFile",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "{{4.data.url}}",
                "method": "get",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{2.WA_TOKEN}}"
                  }
                ],
                "qs": [],
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "serializeUrl": false,
                "timeout": "300",
                "followAllRedirects": false
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": -200,
                  "name": "Download file"
                }
              }
            },
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.anthropic.com/v1/files",
                "method": "post",
                "headers": [
                  {
                    "name": "x-api-key",
                    "value": "{{2.ANTHROPIC_API_KEY}}"
                  },
                  {
                    "name": "anthropic-version",
                    "value": "2023-06-01"
                  }
                ],
                "qs": [],
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "300",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "serializeUrl": false,
                "followAllRedirects": false,
                "bodyType": "multipart_form_data",
                "formDataFields": [
                  {
                    "key": "file",
                    "fieldType": "file",
                    "data": "{{5.data}}",
                    "fileName": "{{1.filename}}"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -200,
                  "name": "Upload to Claude Files"
                }
              }
            },
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.anthropic.com/v1/messages",
                "method": "post",
                "headers": [
                  {
                    "name": "x-api-key",
                    "value": "{{2.ANTHROPIC_API_KEY}}"
                  },
                  {
                    "name": "anthropic-version",
                    "value": "2023-06-01"
                  },
                  {
                    "name": "anthropic-beta",
                    "value": "server-side-fallback-2026-07-01"
                  }
                ],
                "qs": [],
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "300",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "serializeUrl": false,
                "followAllRedirects": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"model\": \"{{2.MODEL}}\", \"max_tokens\": 16000, \"fallbacks\": \"default\", \"output_config\": {\"effort\": \"low\"}, \"tools\": [{\"type\": \"code_execution_20260521\", \"name\": \"code_execution\"}], \"messages\": [{\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": \"A client sent an article file on WhatsApp. The file has been uploaded into your code execution container (find it with: find / -type f -mmin -30 \\\\( -iname '*.docx' -o -iname '*.doc' -o -iname '*.pdf' -o -iname '*.txt' -o -iname '*.odt' -o -iname '*.rtf' \\\\) 2>/dev/null | grep -v -e '^/proc' -e '^/sys' -e '^/usr' | head).\\n\\nUse code to read it:\\n- .docx: read word/document.xml and word/_rels/document.xml.rels with zipfile (or python-docx) so that every hyperlink keeps its exact URL and anchor text.\\n- .pdf: pypdf (keep link annotations' URLs).\\n- .txt / other text: read as UTF-8.\\n\\nThen answer with ONLY the article as simple HTML, nothing else:\\n<h1> for the title, <h2>/<h3> for subheadings, <p>, <ul>/<ol>/<li>, <strong>, <em>, and <a href=\\\"URL\\\">anchor</a> for every link.\\nDo not correct, rewrite, shorten or comment on anything. Skip images.\\nIf the file cannot be read or is not an article, answer exactly: UNREADABLE_FILE\"}, {\"type\": \"container_upload\", \"file_id\": \"{{6.data.id}}\"}]}]}"
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": -200,
                  "name": "Claude reads file"
                }
              }
            },
            {
              "id": 8,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://api.anthropic.com/v1/files/{{6.data.id}}",
                "method": "delete",
                "headers": [
                  {
                    "name": "x-api-key",
                    "value": "{{2.ANTHROPIC_API_KEY}}"
                  },
                  {
                    "name": "anthropic-version",
                    "value": "2023-06-01"
                  }
                ],
                "qs": [],
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "300",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "serializeUrl": false,
                "followAllRedirects": false
              },
              "metadata": {
                "designer": {
                  "x": 2100,
                  "y": -200,
                  "name": "Delete uploaded file"
                }
              }
            },
            {
              "id": 9,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{{last(map(7.data.content; text; type; text))}}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 2400,
                  "y": -200,
                  "name": "Return article"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 10,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://docs.google.com/document/d/{{replace(1.text; /^[\\s\\S]*?docs\\.google\\.com\\/document\\/d\\/([A-Za-z0-9_-]+)[\\s\\S]*$/; $1)}}/export?format=html",
                "method": "get",
                "headers": [],
                "qs": [],
                "parseResponse": false,
                "authUser": "",
                "authPass": "",
                "timeout": "300",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "serializeUrl": false,
                "followAllRedirects": false
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 100,
                  "name": "Download Google Doc"
                }
              },
              "filter": {
                "name": "Google Docs link",
                "conditions": [
                  [
                    {
                      "a": "{{length(1.media_id)}}",
                      "o": "number:equal",
                      "b": "0"
                    },
                    {
                      "a": "{{1.text}}",
                      "o": "text:contain",
                      "b": "docs.google.com/document/d/"
                    }
                  ]
                ]
              }
            },
            {
              "id": 11,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{{replace(10.data; /<style[^<]*<\\/style>/g; emptystring)}}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 100,
                  "name": "Return article"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 12,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 350,
                  "name": "Nothing to read"
                }
              },
              "filter": {
                "name": "Plain message",
                "conditions": [
                  [
                    {
                      "a": "{{length(1.media_id)}}",
                      "o": "number:equal",
                      "b": "0"
                    },
                    {
                      "a": "{{1.text}}",
                      "o": "text:notcontain",
                      "b": "docs.google.com/document/d/"
                    }
                  ]
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com"
  }
}
